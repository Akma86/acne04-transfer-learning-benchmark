# Keep all .gitkeep files across the repository
!**/.gitkeep
!*.gitkeep

# ==============================================================================
# Byte-compiled / optimized / DLL files
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so




# ==============================================================================
# Virtual Environments
# ==============================================================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==============================================================================
# Jupyter Notebooks
# ==============================================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ==============================================================================
# Data and Datasets (Do NOT commit large image files or archives)
# ==============================================================================
data/raw/acne_1024/
data/raw/*.zip
data/raw/*.tar.gz
data/raw/*.rar
data/processed/*
!data/processed/.gitkeep
*.jpg
*.jpeg
*.png

# ==============================================================================
# Model Weights, Checkpoints & Artifacts
# ==============================================================================
outputs/checkpoints/*
!outputs/checkpoints/.gitkeep
outputs/logs/*
!outputs/logs/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
*.pt
*.pth
*.onnx
*.tflite
*.h5
*.pkl
*.bin

# ==============================================================================
# Academic Papers & Research Docs (Keep folder structure via .gitkeep)
# ==============================================================================
docs/*
!docs/.gitkeep
!docs/Tugas/
!docs/Tugas/*.docx
!docs/references/
docs/references/*
!docs/references/.gitkeep

# Proposal Paper & Thesis (LaTeX)
!docs/paper/
docs/paper/*
!docs/paper/.gitkeep
!docs/paper/*.tex
!docs/paper/*.bib
!docs/paper/*.txt
!docs/paper/*.pdf
!docs/paper/*.png
!docs/paper/Gambar/
!docs/paper/Gambar/*
docs/paper/build/
docs/paper/*.aux
docs/paper/*.bbl
docs/paper/*.blg
docs/paper/*.log
docs/paper/*.toc
docs/paper/*.out
docs/paper/*.synctex.gz
docs/paper/*.fls
docs/paper/*.fdb_latexmk

# Local scratch and knowledge graph outputs
scratch/
graphify-out/
.agents/

# ==============================================================================
# OS & Editor specific files
# ==============================================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
